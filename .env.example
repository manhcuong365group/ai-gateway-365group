# === AI Gateway config (KHÔNG commit .env thật) ===
# Credential chỉ ở đây / secret manager — KHÔNG trong prompt, KHÔNG trong Google Sheet.

# DB state machine (Supabase/Postgres)
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/ai_gateway

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_ID=            # pin cụ thể, CẤM alias "latest"
PROMPT_VERSION=v1
SCHEMA_VERSION=v1

# Google (Sheets/Drive/GSC/GA4) — service account
GOOGLE_SA_JSON_PATH=
APPROVER_OAUTH_DOMAIN=365group.com.vn

# Token tách môi trường (Blocker #1)
CMS_STAGING_TOKEN=
CMS_PRODUCTION_TOKEN=

# Guardrail
DEFAULT_DRY_RUN=true
DAILY_BUDGET_USD=
GSC_DAILY_QUOTA=
